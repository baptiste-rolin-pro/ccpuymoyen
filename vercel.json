{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/pages/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pages/les-activites/",
      "destination": "/sorties/",
      "permanent": true
    },
    {
      "source": "/pages/les-activites/la-vie-du-club.html",
      "destination": "/actualites/",
      "permanent": true
    },
    {
      "source": "/pages/les-activites/calendrier-2020.html",
      "destination": "/sorties/",
      "permanent": true
    },
    {
      "source": "/pages/le-club/",
      "destination": "/le-club/",
      "permanent": true
    },
    {
      "source": "/pages/le-club/presentation.html",
      "destination": "/le-club/",
      "permanent": true
    },
    {
      "source": "/pages/le-club/ou-sommes-nous.html",
      "destination": "/sorties/",
      "permanent": true
    },
    {
      "source": "/pages/le-club/rejoindre-l-association.html",
      "destination": "/nous-rejoindre/",
      "permanent": true
    },
    {
      "source": "/pages/le-club/reglement-interieur.html",
      "destination": "/le-club/reglement-interieur/",
      "permanent": true
    },
    {
      "source": "/pages/le-club/la-tenue-du-club.html",
      "destination": "/le-club/",
      "permanent": true
    },
    {
      "source": "/pages/le-club/nos-sponsors.html",
      "destination": "/partenaires/",
      "permanent": true
    },
    {
      "source": "/contact/:path*",
      "destination": "/nous-rejoindre/",
      "permanent": true
    },
    {
      "source": "/agenda/:path*",
      "destination": "/actualites/",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/actualites/",
      "permanent": true
    },
    {
      "source": "/album-photos/:path*",
      "destination": "/galerie/",
      "permanent": true
    },
    {
      "source": "/videos/:path*",
      "destination": "/galerie/",
      "permanent": true
    },
    {
      "source": "/medias/files/parcours-ccp-2026.pdf",
      "destination": "/documents/parcours-ccp-2026.pdf",
      "permanent": true
    },
    {
      "source": "/medias/files/parcours-ccp-2028.pdf",
      "destination": "/documents/parcours-ccp-2026.pdf",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(img|partners|brand|_next/static)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
