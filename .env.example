# Copier ce fichier en .env.local pour le développement, et déclarer les mêmes
# variables dans Vercel (Settings → Environment Variables).

# Clé de signature des sessions de l'espace membres (au moins 32 caractères aléatoires).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Comptes membres (JSON). Générer une entrée : npm run membre:ajouter -- email@exemple.fr "Prénom Nom"
MEMBERS='[]'

# Formulaire de contact (Formspree, Web3Forms…). Vide = formulaire masqué.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# URL publique du site
NEXT_PUBLIC_SITE_URL=https://www.ccpuymoyen.com
